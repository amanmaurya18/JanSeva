# Optional; leave unset for the no-key demo. Select a model available to your Gemini account.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional persistent directory for citizen accounts (Node.js 22.13+).
# Defaults to .data; mount persistent storage in production.
ACCOUNT_DATA_DIR=

# Optional Google Cloud Vertex AI express-mode summary provider.
# Select a model enabled for your Cloud account; both values are required.
# When either is set, Vertex takes precedence over the Gemini Developer API.
VERTEX_API_KEY=
VERTEX_MODEL=
